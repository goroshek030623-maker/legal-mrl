})

// AI-анализ дела
app.post('/api/cases/:id/analyze', async (req, res) => {
  try {
    const caseId = req.params.id
    
    // Получаем данные дела
    const caseData = await db.select().from(cases).where(eq(cases.id, caseId))
    const docs = await db.select().from(documents).where(eq(documents.caseId, caseId))
    
    if (!caseData.length) {
      return res.status(404).json({ error: 'Case not found' })
    }
    
    const c = caseData[0]
    
    // Читаем текст из PDF документов
    let documentsText = ''
    for (const doc of docs) {
      const isPdf = doc.type === 'application/pdf' || doc.name.toLowerCase().endsWith('.pdf')
      const isDocx = doc.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || doc.name.toLowerCase().endsWith('.docx')
      const isDoc = doc.type === 'application/msword' || doc.name.toLowerCase().endsWith('.doc')
      const isTxt = doc.type === 'text/plain' || doc.name.toLowerCase().endsWith('.txt')
      
      if (!isPdf && !isDocx && !isDoc && !isTxt) continue
      
      try {
        console.log('Reading doc:', doc.name, 'type:', doc.type, 'path:', doc.path)
        let text = ''
        
        if (isPdf) {
          const dataBuffer = await fs.promises.readFile(doc.path)
          const pdfDocument = await pdfjsLib.getDocument({ 
            data: new Uint8Array(dataBuffer),
            useSystemFonts: true
          }).promise
          let fullText = ''
          for (let i = 1; i <= pdfDocument.numPages; i++) {
            const page = await pdfDocument.getPage(i)
            const textContent = await page.getTextContent()
            // Sort items by Y position (top to bottom) then X (left to right)
            const items = textContent.items.map((item: any) => ({
              str: item.str,
              x: item.transform[4],
              y: item.transform[5]
            })).sort((a: any, b: any) => {
              if (Math.abs(b.y - a.y) > 3) return b.y - a.y
              return a.x - b.x
            })
            let pageText = ''
            let lastY = null
            for (const item of items) {
              if (lastY !== null && Math.abs(lastY - item.y) > 3) {
                pageText += '\n'
              } else if (lastY !== null) {
                pageText += ' '
              }
              pageText += item.str
              lastY = item.y
            }
            fullText += pageText + '\n\n'
          }
          // Fallback: если pdfjs не извлёк текст (сканированный PDF), пробуем pdftotext
          if (fullText.trim().length < 50) {
            console.log('PDF text too short, trying pdftotext fallback for:', doc.name)
            try {
              const { stdout } = await execAsync(`pdftotext "${doc.path}" -`)
              fullText = stdout
              console.log('pdftotext extracted length:', fullText.length)
            } catch (e) {
              console.log('pdftotext failed:', (e as Error).message)
            }
          }
        // Если текст всё ещё пустой — OCR через tesseract
          if (fullText.trim().length < 50) {
            console.log('PDF text still too short, trying OCR for:', doc.name)
            try {
              const tmpDir = `/tmp/ocr-${Date.now()}`
              await fs.promises.mkdir(tmpDir, { recursive: true })
              // Конвертируем PDF в PNG (первые 5 страниц для скорости)
              const { stdout: ppmStdout } = await execAsync(`pdftoppm -png -f 1 -l 5 -r 300 "${doc.path}" "${tmpDir}/page"`)
              console.log('pdftoppm output:', ppmStdout)
              // Распознаём каждую страницу
              const pages = await fs.promises.readdir(tmpDir)
              let ocrText = ''
              for (const page of pages.sort()) {
                if (!page.endsWith('.png')) continue
                const pagePath = `${tmpDir}/${page}`
                const { stdout: ocrStdout } = await execAsync(`tesseract "${pagePath}" stdout -l rus`)
                ocrText += ocrStdout + '\n\n'
                console.log('OCR page', page, 'length:', ocrStdout.length)
              }
              fullText = ocrText
              console.log('OCR total extracted length:', fullText.length)
              // Чистим временные файлы
              await fs.promises.rm(tmpDir, { recursive: true, force: true })
            } catch (e) {
              console.log('OCR failed:', (e as Error).message)
            }
          }
        } else if (isDocx) {
          const fullText = await extractDocxText(doc.path)
          text = fullText.substring(0, 15000)
          console.log('DOCX text length:', fullText.length)
        } else if (isDoc) {
          const fullText = await extractDocText(doc.path)
          text = fullText.substring(0, 15000)
          console.log('DOC text length:', fullText.length)
        } else if (isTxt) {
          const fullText = await fs.promises.readFile(doc.path, 'utf8')
          text = fullText.substring(0, 15000)
          console.log('TXT text length:', fullText.length)
        }
        
        documentsText += `\n--- Документ: ${doc.name} ---\n${text}\n`
      } catch (e) {
        console.log('Doc read error:', (e as Error).message)
        documentsText += `\n--- Документ: ${doc.name} (не удалось прочитать: ${(e as Error).message}) ---\n`
      }
    }
    
    // Формируем промпт для OpenAI
    const prompt = `
Проанализируй юридическую ситуацию:

Название: ${c.title}
Описание: ${c.description || 'Не указано'}
Документов: ${docs.length}

${documentsText ? 'Содержание документов:' + documentsText : 'Документы приложены, но текст не извлечён.'}

Дай краткий анализ (3-5 пунктов):
1. Что нужно сделать в первую очередь
2. Какие документы потребуются
3. Возможные риски
4. Рекомендации по стратегии

В самом конце ответа, на отдельной строке, обязательно добавь:
РЕКОМЕНДУЕМЫЕ ДЕЙСТВИЯ: [ключи через запятую]

Доступные ключи: claim, lawsuit, contract, settlement, deferment, counterclaim, objection, expert, lawyer, respond
Пример: РЕКОМЕНДУЕМЫЕ ДЕЙСТВИЯ: claim, contract
`

    const requestId = uuidv4()
    const analysisRaw = await runWithQueue(() => chatWithWebSearch(
      'Ты юридический консультант. Даёшь конкретные рекомендации. Всегда проверяй актуальность законов на 2026 год.',
      prompt,
      18000
    ), requestId)
    
    // Парсим рекомендуемые действия из ответа AI
    let analysis = analysisRaw
    let recommendedActions: string[] = []
    
    console.log('[ANALYZE] Raw response ending:', analysisRaw.substring(analysisRaw.length - 200))
    
    const actionsMatch = analysisRaw.match(/РЕКОМЕНДУЕМЫЕ ДЕЙСТВИЯ[:\s]*([\w\s,]+)/is)
    console.log('[ANALYZE] Match:', actionsMatch)
    if (actionsMatch) {
      const actionsStr = actionsMatch[1]
      console.log('[ANALYZE] Extracted:', actionsStr)
      const validActions = ['claim', 'lawsuit', 'contract', 'settlement', 'deferment', 'counterclaim', 'objection', 'expert', 'lawyer', 'respond']
      recommendedActions = actionsStr.split(/[,\s]+/).map(a => a.trim().toLowerCase()).filter(a => validActions.includes(a))
      console.log('[ANALYZE] Parsed:', recommendedActions)
      analysis = analysisRaw.replace(/РЕКОМЕНДУЕМЫЕ ДЕЙСТВИЯ[:\s]*[\w\s,]+/is, '').trim()
    } else {
      console.log('[ANALYZE] No match found')
    }
    
    // Очищаем markdown из анализа перед сохранением
    function cleanMarkdownBackend(text: string): string {
      let t = text
      // Remove heading markers
      t = t.replace(/^#{1,6}\s*/gm, '')
      // Remove table separators
      t = t.replace(/^\|[\s\-:]+\|$/gm, '')
      // Remove table row markers
      t = t.replace(/^\|/gm, '').replace(/\|$/gm, '')
      // Remove list markers
      t = t.replace(/^\s*([-*•+]|\d+\.)\s+/gm, '')
      // Remove bold markers
      t = t.replace(/\*\*(.*?)\*\*/g, '$1')
      // Remove italic markers
      t = t.replace(/\*(.*?)\*/g, '$1')
      // Remove code blocks
      t = t.replace(/```[\s\S]*?```/g, '')
      // Remove inline code
      t = t.replace(/`([^`]+)`/g, '$1')
      // Remove blockquotes
      t = t.replace(/^\s*>\s*/gm, '')
      // Remove links [text](url) -> text
      t = t.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      // Remove stray markdown chars
      t = t.replace(/_{1,2}/g, '')
      // Remove horizontal rules
      t = t.replace(/^---\s*$/gm, '')
      // Remove table separators and markers
      t = t.replace(/^\|?\s*:?-{3,}\s*:?\|?$/gm, '')
      t = t.replace(/^\s*:?-{3,}\s*:?\s*$/gm, '')
      t = t.replace(/^\|\s*/gm, '')
      t = t.replace(/\s*\|$/gm, '')
      t = t.replace(/\s*\|\s*/g, ' ')
      return t.trim()
    }
    
    analysis = cleanMarkdownBackend(analysis)
    
    // Сохраняем анализ и рекомендации
    await db.update(cases)
      .set({ 
        analysis, 
        recommendedActions: JSON.stringify(recommendedActions),
        status: 'active' 
      })
      .where(eq(cases.id, caseId))
    
    res.json({ analysis, recommendedActions })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'Failed to analyze' })
  }
})

