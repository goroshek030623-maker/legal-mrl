app.post('/api/cases/:id/check-contractor', async (req, res) => {
  try {
    const caseId = req.params.id
    const { name, inn, ogrn, address } = req.body

    const caseData = await db.select().from(cases).where(eq(cases.id, caseId))
    if (!caseData.length) {
      return res.status(404).json({ error: 'Case not found' })
    }

    const c = caseData[0]

    const prompt = `Ты — юридический аналитик. Проведи проверку контрагента и выдай структурированный анализ.

ДАННЫЕ КОНТРАГЕНТА:
- Название: ${name || 'Не указано'}
- ИНН: ${inn || 'Не указан'}
- ОГРН: ${ogrn || 'Не указан'}
- Адрес: ${address || 'Не указан'}

ЗАДАЧИ:
1. Проверь ИНН и ОГРН на формальную корректность (контрольные суммы)
2. Оцени риски: отсутствие данных, несоответствие формата — всё считай фактором риска
3. Если данные минимальны — укажи, что проверка ограничена, рекомендуй запросить выписку из ЕГРЮЛ/ЕГРИП
4. Перечисли рекомендуемые проверки: налоговая задолженность, судебные дела, арбитражная практика, репутация
5. Дай рекомендацию: сотрудничать, требовать дополнительные гарантии, или отказаться

Формат: кратко, по делу, структурировано. Используй заголовки: Риски, Рекомендации, Дополнительные проверки.`

    const requestId = uuidv4()
    const analysis = await runWithQueue(() => chatWithWebSearch(
      'Ты эксперт по проверке контрагентов. Анализируй риски на основе предоставленных данных. Всегда указывай ограничения проверки, если данных недостаточно.',
      prompt,
      2000
    ), requestId)

    res.json({ analysis })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'Failed to check contractor' })
  }
})

