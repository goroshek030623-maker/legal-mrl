// ─── AI Queue System (max 5 concurrent) ───────────────────────────────────
const CONCURRENCY_LIMIT = 5
interface QueueItem {
  id: string
  promise: () => Promise<string>
  resolve: (value: string) => void
  reject: (reason: any) => void
}
const aiQueue: QueueItem[] = []
let runningCount = 0
const aiQueueStatus = new Map<string, { status: 'queued' | 'running'; position: number; startedAt?: number }>()

async function processQueue() {
  if (runningCount >= CONCURRENCY_LIMIT || aiQueue.length === 0) return

  const item = aiQueue.shift()!
  runningCount++
  aiQueueStatus.set(item.id, { status: 'running', position: 0, startedAt: Date.now() })

  try {
    const result = await item.promise()
    item.resolve(result)
  } catch (err) {
    item.reject(err)
  } finally {
    runningCount--
    aiQueueStatus.delete(item.id)
    processQueue()
  }
}

async function runWithQueue(promise: () => Promise<string>, requestId: string): Promise<string> {
  return new Promise((resolve, reject) => {
    aiQueue.push({ id: requestId, promise, resolve, reject })
    aiQueueStatus.set(requestId, { status: 'queued', position: aiQueue.length })
    processQueue()
  })
}

app.get('/api/queue-status/:requestId', (req, res) => {
  const status = aiQueueStatus.get(req.params.requestId)
  if (!status) return res.json({ status: 'done', position: 0 })

  if (status.status === 'running') {
    return res.json({ status: 'running', position: 0 })
  }

  const position = aiQueue.findIndex(item => item.id === req.params.requestId) + 1
  res.json({ status: 'queued', position })
})

// Helper: web search with two-round flow for Moonshot API
async function extractDocxText(filePath: string): Promise<string> {
  const data = await fs.promises.readFile(filePath)
  const zip = await JSZip.loadAsync(data)
  
  // DOCX — это zip с XML внутри
  const xmlContent = await zip.file('word/document.xml')?.async('text')
  if (!xmlContent) return ''
  
  // Простой парсинг: убираем XML теги
  let text = xmlContent.replace(/<[^>]+>/g, ' ')
  text = text.replace(/\s+/g, ' ').trim()
  return text
}

async function extractDocText(filePath: string): Promise<string> {
  // .doc — старый бинарный формат, используем word-extractor
  const extractor = new WordExtractor()
  const doc = await extractor.extract(filePath)
  return doc.getBody() || ''
}

async function chatWithWebSearch(
  systemContent: string,
  userContent: string,
  maxTokens: number = 3000
): Promise<string> {
  const tools = [
    {
      type: 'builtin_function',
      function: { name: '$web_search' }
    }
  ]

  const messages: any[] = [
    { role: 'system', content: GUARD_PROMPT + '\n\n' + systemContent },
    { role: 'user', content: userContent }
  ]

  // Round 1: Initial request with tools
  let completion = await moonshot.chat.completions.create({
    model: 'kimi-k2.5',
    messages,
    temperature: 0.6,
    max_tokens: maxTokens,
    thinking: { type: 'disabled' },
    tools
  })

  let choice = completion.choices[0]

  // Round 2: If tool_calls, send back tool results
  if (choice.finish_reason === 'tool_calls' && choice.message.tool_calls) {
    messages.push({
      role: 'assistant',
      content: choice.message.content || '',
      tool_calls: choice.message.tool_calls
    })

    for (const toolCall of choice.message.tool_calls) {
      const toolCallName = toolCall.function.name
      const toolCallArguments = JSON.parse(toolCall.function.arguments)
      
      // For Moonshot $web_search, just return arguments as-is (server-side search)
      let toolResult: any
      if (toolCallName === '$web_search') {
        toolResult = toolCallArguments
      } else {
        toolResult = { error: `Unknown tool: ${toolCallName}` }
      }

      messages.push({
        role: 'tool',
        tool_call_id: toolCall.id,
        name: toolCallName,
        content: JSON.stringify(toolResult)
      })
    }

    // Second request with tool results
    completion = await moonshot.chat.completions.create({
      model: 'kimi-k2.5',
      messages,
      temperature: 0.6,
      max_tokens: maxTokens,
      thinking: { type: 'disabled' },
      tools
    })
    
    choice = completion.choices[0]
  }

  return choice.message.content || ''
}

// Нормализация имени файла (кириллица → латиница)
function normalizeFilename(name: string): string {
  // Декодируем из latin1 если нужно
  let decoded = name
  try {
    decoded = Buffer.from(name, 'latin1').toString('utf8')
  } catch (e) {
    decoded = name
  }
  
  const map: Record<string, string> = {
    'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'yo','ж':'zh','з':'z','и':'i',
    'й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t',
    'у':'u','ф':'f','х':'h','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ъ':'','ы':'y','ь':'',
    'э':'e','ю':'yu','я':'ya',
    'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Ё':'Yo','Ж':'Zh','З':'Z','И':'I',
    'Й':'Y','К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R','С':'S','Т':'T',
    'У':'U','Ф':'F','Х':'H','Ц':'Ts','Ч':'Ch','Ш':'Sh','Щ':'Shch','Ъ':'','Ы':'Y','Ь':'',
    'Э':'E','Ю':'Yu','Я':'Ya',' ':'_'
  }
  return decoded.split('').map(c => map[c] || c).join('')
}

