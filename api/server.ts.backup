app.post('/api/cases/:id/save-contractor-report', async (req, res) => {
  try {
    const caseId = req.params.id
    const { contractorData, analysis } = req.body

    // Создаём PDF-файл с отчётом (просто текстовый файл для начала)
    const reportText = `ОТЧЁТ О ПРОВЕРКЕ КОНТРАГЕНТА

Дата: ${new Date().toLocaleDateString('ru-RU')}
Дело: ${caseId}

ДАННЫЕ КОНТРАГЕНТА:
- Название: ${contractorData?.name || 'Не указано'}
- ИНН: ${contractorData?.inn || 'Не указан'}
- ОГРН: ${contractorData?.ogrn || 'Не указан'}
- Адрес: ${contractorData?.address || 'Не указан'}

РЕЗУЛЬТАТ АНАЛИЗА:
${analysis}

---
Сгенерировано автоматически Legal MRL
`

    const docId = uuidv4()
    const filePath = `uploads/${docId}.txt`
    await fs.promises.writeFile(filePath, reportText, 'utf8')

    await db.insert(documents).values({
      id: docId,
      caseId,
      name: `Проверка_контрагента_${contractorData?.name || 'без_имени'}_${new Date().toISOString().slice(0,10)}.txt`,
      type: 'text/plain',
      size: Buffer.byteLength(reportText, 'utf8'),
      path: filePath
    })

    res.json({ success: true, documentId: docId })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'Failed to save report' })
  }
})

