// Сохранение сгенерированного документа в дело (после оплаты)
app.post('/api/cases/:id/save-generated-doc', async (req, res) => {
  try {
    const caseId = req.params.id
    const { filename, content } = req.body
    
    const docId = uuidv4()
    const filePath = path.join('/var/www/legal-mrl/uploads', docId + '.docx')
    
    // Сохраняем контент как текстовый файл (frontend генерирует .docx blob)
    // На самом деле frontend отправляет base64 blob .docx
    const base64Data = content.split(',')[1] || content
    const buffer = Buffer.from(base64Data, 'base64')
    await fs.promises.writeFile(filePath, buffer)
    
    await db.insert(documents).values({
      id: docId,
      caseId: caseId,
      name: filename || 'Документ.docx',
      type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      size: buffer.length,
      path: filePath
    })
    
    res.json({ success: true, documentId: docId })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'Failed to save document' })
  }
})

// Serve static files from production dist
app.use(express.static('/var/www/legal-mrl/dist'))


// Создание платежа через ITPay
app.post('/api/create-payment', async (req, res) => {
  try {
    const { amount, orderId, description, method = 'sbp', successUrl, successUrlDescription } = req.body
    
    const publicId = process.env.ITPAY_PUBLIC_ID
    const apiSecret = process.env.ITPAY_API_SECRET
    
    if (!publicId || !apiSecret) {
      return res.status(500).json({ error: 'ITPAY credentials not configured' })
    }
    
    const clientPaymentId = orderId || `legal_mrl_${Date.now()}`
    
    const payload = {
      amount: String(amount),
      client_payment_id: clientPaymentId,
      method: method,
      description: description || 'Оплата юридических услуг',
      success_url: successUrl || 'http://62.113.110.117:8081/payment/success',
      success_url_description: successUrlDescription || 'Вернуться на сайт',
      metadata: {
        source: 'legal_mrl',
        case_id: orderId || null
      }
    }
    
    const auth = Buffer.from(`${publicId}:${apiSecret}`).toString('base64')
    
    const itpayRes = await fetch('https://api.gw.itpay.ru/v1/payments', {
      method: 'POST',
      headers: {
        'Authorization': `Basic ${auth}`,
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(payload)
    })
    
    const itpayData = await itpayRes.json().catch(() => ({}))
    
    if (!itpayRes.ok) {
      console.error('ITPay error:', itpayRes.status, itpayData)
      return res.status(500).json({ 
        error: 'ITPay API error', 
        status: itpayRes.status, 
        details: itpayData 
      })
    }
    
    // ITPay оборачивает ответ в поле data
    const paymentData = itpayData.data || itpayData
    
    // Сохраняем в БД
    await db.insert(payments).values({
      id: uuidv4(),
      paymentId: paymentData.id || 'unknown',
      caseId: orderId || null,
      amount: parseInt(amount),
      status: paymentData.status || 'pending',
      paymentMethod: method,
      paymentData: { ...paymentData, payload }
    })
    
    res.json({
      success: true,
      paymentId: paymentData.id,
      status: paymentData.status,
      amount: amount,
      paymentUrl: paymentData.payment_qr_urls || null,
      paymentQrImages: paymentData.payment_qr_images || null,
      method: paymentData.method,
      description: paymentData.description,
      created: paymentData.created
    })
  } catch (err) {
    console.error('Create payment error:', err)
    res.status(500).json({ error: 'Failed to create payment', details: err.message })
  }
})

// Webhook для ITPay (СБП и другие методы)
app.post('/api/webhook/payment', async (req, res) => {
  try {
    const body = req.body
    
    // Логируем все входящие вебхуки для отладки
    console.log('ITPay webhook received:', JSON.stringify(body, null, 2))
    
    // ITPay может отправлять данные в разных форматах — обрабатываем оба
    const paymentId = body.id || body.payment_id || body.data?.id || 'unknown'
    const status = body.status || body.data?.status || 'unknown'
    const amount = body.amount || body.data?.amount || 0
    const orderId = body.order_id || body.client_payment_id || body.metadata?.case_id || null
    const paymentMethod = body.method || body.payment_method || 'unknown'
    
    // Сохраняем в БД
    await db.insert(payments).values({
      id: uuidv4(),
      paymentId: String(paymentId),
      caseId: orderId,
      amount: amount ? Math.round(parseFloat(amount)) : 0,
      status: String(status),
      paymentMethod: String(paymentMethod),
      paymentData: body
    }).catch(err => {
      // Если уже есть запись с таким paymentId — обновляем
      console.log('Webhook insert skipped (duplicate?), will try update if needed:', err.message)
    })
    
    // Если платёж успешен — обновляем дело
    if (status === 'paid' || status === 'completed' || status === 'succeeded' || status === 'success') {
      if (orderId) {
        await db.update(cases)
          .set({ status: 'paid', updatedAt: new Date() })
          .where(eq(cases.id, orderId))
          .catch(err => console.log('Case update skipped:', err.message))
        
        console.log('Payment successful for order:', orderId)
      }
    }
    
    // Всегда отвечаем 200, иначе ITPay будет ретраить
    res.status(200).json({ status: 'ok', received: true })
  } catch (err) {
    console.error('Webhook error:', err)
    res.status(200).json({ status: 'ok', error: 'processed' })
  }
})

// Fallback to index.html for SPA
app.get('*', (req, res) => {
  res.sendFile('/var/www/legal-mrl/dist/index.html')
})

const PORT = process.env.PORT || 3002
app.listen(PORT, () => {
  console.log(`Legal MRL API running on port ${PORT}`)
})
