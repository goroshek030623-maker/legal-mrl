// Оплата документа
app.post('/api/documents/:id/pay', async (req, res) => {
  try {
    const docId = req.params.id
    const docs = await db.select().from(documents).where(eq(documents.id, docId))
    
    if (!docs.length) {
      return res.status(404).json({ error: 'Document not found' })
    }
    
    const doc = docs[0]
    const { amount = 500, method = 'sbp' } = req.body
    
    const publicId = process.env.ITPAY_PUBLIC_ID
    const apiSecret = process.env.ITPAY_API_SECRET
    
    if (!publicId || !apiSecret) {
      return res.status(500).json({ error: 'ITPAY credentials not configured' })
    }
    
    const clientPaymentId = 
    
    const payload = {
      amount: String(amount),
      client_payment_id: clientPaymentId,
      method: method,
      description: ,
      success_url: 'http://62.113.110.117:8081/payment/success',
      success_url_description: 'Вернуться на сайт',
      metadata: {
        source: 'legal_mrl',
        document_id: docId,
        case_id: doc.caseId
      }
    }
    
    const auth = Buffer.from().toString('base64')
    
    const itpayRes = await fetch('https://api.gw.itpay.ru/v1/payments', {
      method: 'POST',
      headers: {
        'Authorization': ,
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(payload)
    })
    
    const itpayData = await itpayRes.json().catch(() => ({}))
    
    if (!itpayRes.ok) {
      console.error('ITPay error:', itpayRes.status, itpayData)
      return res.status(500).json({ 
        error: 'ITPay API error', 
        status: itpayRes.status, 
        details: itpayData 
      })
    }
    
    const paymentData = itpayData.data || itpayData
    
    await db.insert(payments).values({
      id: uuidv4(),
      paymentId: paymentData.id || 'unknown',
      caseId: doc.caseId,
      amount: parseInt(amount),
      status: paymentData.status || 'pending',
      paymentMethod: method,
      paymentData: { ...paymentData, payload }
    })
    
    res.json({
      success: true,
      paymentId: paymentData.id,
      status: paymentData.status,
      amount: amount,
      paymentUrl: paymentData.payment_qr_urls || null,
      paymentQrImages: paymentData.payment_qr_images || null,
      method: paymentData.method,
      description: paymentData.description,
      created: paymentData.created
    })
  } catch (err) {
    console.error('Document payment error:', err)
    res.status(500).json({ error: 'Failed to create payment', details: (err as Error).message })
  }
})

// Извлечение текста из документа
app.post('/api/documents/:id/extract', async (req, res) => {
  try {
    const docId = req.params.id
    const docs = await db.select().from(documents).where(eq(documents.id, docId))
    
    if (!docs.length) {
      return res.status(404).json({ error: 'Document not found' })
    }
    
    const doc = docs[0]
    let text = ''
    
    if (doc.type === 'application/pdf' || doc.name.endsWith('.pdf')) {
      const dataBuffer = await fs.promises.readFile(doc.path)
      const pdfDocument = await pdfjsLib.getDocument({ 
        data: new Uint8Array(dataBuffer),
        useSystemFonts: true
      }).promise
      let fullText = ''
      for (let i = 1; i <= pdfDocument.numPages; i++) {
        const page = await pdfDocument.getPage(i)
        const textContent = await page.getTextContent()
        const items = textContent.items.map((item: any) => ({
          str: item.str,
          x: item.transform[4],
          y: item.transform[5]
        })).sort((a: any, b: any) => {
          if (Math.abs(b.y - a.y) > 3) return b.y - a.y
          return a.x - b.x
        })
        let pageText = ''
        let lastY = null
        for (const item of items) {
          if (lastY !== null && Math.abs(lastY - item.y) > 3) {
            pageText += '\n'
          } else if (lastY !== null) {
            pageText += ' '
          }
          pageText += item.str
          lastY = item.y
        }
        fullText += pageText + '\n\n'
      }
      // Fallback: pdftotext
      if (fullText.trim().length < 50) {
        try {
          const { stdout } = await execAsync(`pdftotext "${doc.path}" -`)
          fullText = stdout
        } catch (e) {}
      }
      // OCR fallback
      if (fullText.trim().length < 50) {
        try {
          const tmpDir = `/tmp/ocr-${Date.now()}`
          await fs.promises.mkdir(tmpDir, { recursive: true })
          await execAsync(`pdftoppm -png -f 1 -l 5 -r 300 "${doc.path}" "${tmpDir}/page"`)
          const pages = await fs.promises.readdir(tmpDir)
          let ocrText = ''
          for (const page of pages.sort()) {
            if (!page.endsWith('.png')) continue
            const pagePath = `${tmpDir}/${page}`
            const { stdout: ocrStdout } = await execAsync(`tesseract "${pagePath}" stdout -l rus`)
            ocrText += ocrStdout + '\n\n'
          }
          fullText = ocrText
          await fs.promises.rm(tmpDir, { recursive: true, force: true })
        } catch (e) {}
      }
      text = fullText.substring(0, 40000)
    } else if (doc.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || doc.name.endsWith('.docx')) {
      text = await extractDocxText(doc.path)
    } else if (doc.type === 'application/msword' || doc.name.endsWith('.doc')) {
      text = await extractDocText(doc.path)
    } else if (doc.type === 'text/plain' || doc.name.endsWith('.txt')) {
      text = await fs.promises.readFile(doc.path, 'utf8')
    }
    
    res.json({ text: text.substring(0, 40000), length: text.length })
  } catch (err) {
    console.error('Extract error:', err)
    res.status(500).json({ error: 'Failed to extract text', details: (err as Error).message })
  }
})

// AI Swarm — генерация документа через 3 агента
app.post('/api/cases/:id/swarm-generate', async (req, res) => {
  try {
    const caseId = req.params.id
    const { action, clientData, position, analysisContext } = req.body

    const caseData = await db.select().from(cases).where(eq(cases.id, caseId))
    if (!caseData.length) {
      return res.status(404).json({ error: 'Case not found' })
    }

    const c = caseData[0]
    const docs = await db.select().from(documents).where(eq(documents.caseId, caseId))

    // Читаем текст из документов
    let documentsText = ''
    for (const doc of docs) {
      if (doc.type === 'application/pdf' || doc.name.endsWith('.pdf')) {
        try {
          const dataBuffer = await fs.promises.readFile(doc.path)
          const pdfDocument = await pdfjsLib.getDocument({ 
            data: new Uint8Array(dataBuffer),
            useSystemFonts: true
          }).promise
          let fullText = ''
          for (let i = 1; i <= pdfDocument.numPages; i++) {
            const page = await pdfDocument.getPage(i)
            const textContent = await page.getTextContent()
            // Sort items by Y position (top to bottom) then X (left to right)
            const items = textContent.items.map((item: any) => ({
              str: item.str,
              x: item.transform[4],
              y: item.transform[5]
            })).sort((a: any, b: any) => {
              if (Math.abs(b.y - a.y) > 3) return b.y - a.y
              return a.x - b.x
            })
            let pageText = ''
            let lastY = null
            for (const item of items) {
              if (lastY !== null && Math.abs(lastY - item.y) > 3) {
                pageText += '\n'
              } else if (lastY !== null) {
                pageText += ' '
              }
              pageText += item.str
              lastY = item.y
            }
            fullText += pageText + '\n\n'
          }
          // Fallback: если pdfjs не извлёк текст (сканированный PDF), пробуем pdftotext
          if (fullText.trim().length < 50) {
            console.log('PDF text too short, trying pdftotext fallback for:', doc.name)
            try {
              const { stdout } = await execAsync(`pdftotext "${doc.path}" -`)
              fullText = stdout
              console.log('pdftotext extracted length:', fullText.length)
            } catch (e) {
              console.log('pdftotext failed:', (e as Error).message)
            }
          }
          // Если текст всё ещё пустой — OCR через tesseract
          if (fullText.trim().length < 50) {
            console.log('PDF text still too short, trying OCR for:', doc.name)
            try {
              const tmpDir = `/tmp/ocr-${Date.now()}`
              await fs.promises.mkdir(tmpDir, { recursive: true })
              const { stdout: ppmStdout } = await execAsync(`pdftoppm -png -f 1 -l 5 -r 300 "${doc.path}" "${tmpDir}/page"`)
              console.log('pdftoppm output:', ppmStdout)
              const pages = await fs.promises.readdir(tmpDir)
              let ocrText = ''
              for (const page of pages.sort()) {
                if (!page.endsWith('.png')) continue
                const pagePath = `${tmpDir}/${page}`
                const { stdout: ocrStdout } = await execAsync(`tesseract "${pagePath}" stdout -l rus`)
                ocrText += ocrStdout + '\n\n'
                console.log('OCR page', page, 'length:', ocrStdout.length)
              }
              fullText = ocrText
              console.log('OCR total extracted length:', fullText.length)
              await fs.promises.rm(tmpDir, { recursive: true, force: true })
            } catch (e) {
              console.log('OCR failed:', (e as Error).message)
            }
          }
          // Если текст всё ещё пустой — предупреждение
          if (fullText.trim().length < 10) {
            documentsText += `\n--- Документ: ${doc.name} ---\n[ВНИМАНИЕ: Документ является сканированным изображением или защищённым PDF. Текст не может быть автоматически извлечён. Для AI-анализа рекомендуется загрузить версию в формате DOCX, DOC или TXT.]\n`
            console.log('PDF unreadable, warning generated for:', doc.name)
            continue
          }
          const text = fullText.substring(0, 40000) // Increased from 3000 to 40000
          documentsText += `\n--- Документ: ${doc.name} ---\n${text}\n`
        } catch (e) {
          documentsText += `\n--- Документ: ${doc.name} (не удалось прочитать) ---\n`
        }
      }
    }

    const docNames: Record<string, string> = {
      claim: 'Претензия',
      lawsuit: 'Исковое заявление',
      contract: 'Протокол разногласий',
      objection: 'Возражения на исковое заявление',
      response: 'Ответ на претензию',
      counterclaim: 'Встречный иск',
      settlement: 'Мировое соглашение',
      deferment: 'Ходатайство об отсрочке исполнения'
    }

    const docName = docNames[action] || 'Документ'
    const positionText = position === 'plaintiff' ? 'истец' : position === 'defendant' ? 'ответчик' : 'нейтральная сторона'

    // ─── AGENT 1: Аналитик ───
    console.log('[SWARM] Phase 1: Analyst')
    const analystPrompt = `Ты — юридический аналитик. Проанализируй документы дела и выдай структурированный JSON.

Задачи:
1. Выдели стороны (истец, ответчик, третьи лица)
2. Определи предмет спора (сумма, договор, товар, услуга)
3. Найди ключевые даты
4. Опиши суть претензий
5. Перечисли доказательства
6. Укажи применимые нормы права

Формат: ТОЛЬКО JSON. Структура:
{
  "parties": { "plaintiff": "...", "defendant": "..." },
  "subject": "...",
  "key_dates": ["..."],
  "claims": ["..."],
  "evidence": ["..."],
  "applicable_law": ["..."],
  "summary": "..."
}

=== ДОКУМЕНТЫ ДЕЛА ===
${documentsText}

=== КОНТЕКСТ ===
${analysisContext || 'Не указан'}

Анализируй и выдай JSON.`

    const requestId1 = uuidv4()
    const analysisRaw = await runWithQueue(() => chatWithWebSearch(
      'Ты юридический аналитик. Пиши только JSON, без markdown. Всегда проверяй актуальность законов РФ на 2026 год.',
      analystPrompt,
      3000
    ), requestId1)
    // Extract JSON from markdown code blocks if present
    const jsonMatch = analysisRaw.match(/```json\n?([\s\S]*?)\n?```/) || analysisRaw.match(/```\n?([\s\S]*?)\n?```/)
    const analysisJson = jsonMatch ? jsonMatch[1] : analysisRaw
    let analysisData
    try {
      analysisData = JSON.parse(analysisJson)
    } catch (e) {
      analysisData = { error: 'Failed to parse analysis', raw: analysisRaw.substring(0, 500) }
    }

    // ─── AGENT 2: Стратег ───
    console.log('[SWARM] Phase 2: Strategist')
    const strategistPrompt = `Ты — юридический стратег. Получи анализ от аналитика и определи лучшую позицию.

Задачи:
1. Определи позицию клиента (истец/ответчик/нейтрально)
2. Оцени сильные стороны
3. Оцени слабые стороны
4. Определи риски
5. Предложи стратегию (основная и запасная)
6. Рекомендуй тип документа (иск/отзыв/ходатайство/мировое)

Формат: ТОЛЬКО JSON. Структура:
{
  "position": "истец|ответчик|нейтрально",
  "strengths": ["..."],
  "weaknesses": ["..."],
  "risks": ["..."],
  "strategy": "...",
  "fallback_strategy": "...",
  "recommended_document": "...",
  "confidence": "высокая|средняя|низкая"
}

=== АНАЛИЗ ===
${JSON.stringify(analysisData, null, 2)}

=== ПОЗИЦИЯ КЛИЕНТА ===
${positionText}

Определи стратегию и выдай JSON.`

    const requestId2 = uuidv4()
    const strategyRaw = await runWithQueue(() => chatWithWebSearch(
      'Ты юридический стратег. Пиши только JSON, без markdown. Учитывай актуальное законодательство РФ 2026 года.',
      strategistPrompt,
      3000
    ), requestId2)
    const strategyJsonMatch = strategyRaw.match(/```json\n?([\s\S]*?)\n?```/) || strategyRaw.match(/```\n?([\s\S]*?)\n?```/)
    const strategyJson = strategyJsonMatch ? strategyJsonMatch[1] : strategyRaw
    let strategyData
    try {
      strategyData = JSON.parse(strategyJson)
    } catch (e) {
      strategyData = { error: 'Failed to parse strategy', raw: strategyRaw.substring(0, 500) }
    }

    // ─── AGENT 3: Редактор ───
    console.log('[SWARM] Phase 3: Editor')
    const editorPrompt = `Ты — юридический редактор. Напиши полноценный юридический документ: "${docName}".

Правила:
1. Документ соответствует процессуальному законодательству РФ
2. Структура: заголовок, реквизиты, стороны, предмет, обстоятельства, правовое обоснование, просьба
3. Официально-деловой язык
4. Конкретные ссылки на статьи
5. Каждое требование подкреплено фактом или нормой

ДЕЛО: ${c.title}
ОПИСАНИЕ: ${c.description || 'Не указано'}

ПОЗИЦИЯ КЛИЕНТА: ${positionText}
КОНТЕКСТ: ${analysisContext || 'Не указан'}

ДАННЫЕ КЛИЕНТА:
- ФИО: ${clientData?.fio || '________'}
- Компания: ${clientData?.company || '________'}
- ИНН: ${clientData?.inn || '________'}
- ОГРН: ${clientData?.ogrn || '________'}
- Адрес: ${clientData?.address || clientData?.personalAddress || '________'}
- Телефон: ${clientData?.phone || '________'}
- Email: ${clientData?.email || '________'}

=== АНАЛИЗ ===
${JSON.stringify(analysisData, null, 2)}

=== СТРАТЕГИЯ ===
${JSON.stringify(strategyData, null, 2)}

Напиши полный текст юридического документа (готовый к подаче). В начале укажи тип документа: [ИСК|ОТЗЫВ|ХОДАТАЙСТВО|МИРОВОЕ СОГЛАШЕНИЕ].`

    const requestId3 = uuidv4()
    const generatedText = await runWithQueue(() => chatWithWebSearch(
      'Ты профессиональный юрист. Пишешь документы строго по делу, с конкретными ссылками на актуальное законодательство РФ 2026 года. Пиши развёрнуто, детально, не менее 15000 знаков.',
      editorPrompt,
      16000
    ), requestId3)

    // Сохраняем в БД
    await db.update(cases)
      .set({ 
        analysis: JSON.stringify({
          swarm: true,
          analysis: analysisData,
          strategy: strategyData,
          generated: new Date().toISOString()
        }, null, 2),
        generatedDocument: generatedText
      })
      .where(eq(cases.id, caseId))

    res.json({ 
      generatedText,
      swarmData: {
        analysis: analysisData,
        strategy: strategyData
      }
    })
  } catch (err) {
    console.error('[SWARM] Error:', err)
    res.status(500).json({ error: 'Swarm generation failed: ' + (err as Error).message })
  }
})

